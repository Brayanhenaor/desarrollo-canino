---
---

<section id="contacto" data-reveal-group class="relative overflow-hidden px-4 py-24">
  <div class="mx-auto max-w-7xl">
    <div class="relative flex flex-col items-center gap-12 md:flex-row">
      <div data-runner-trail class="pointer-events-none absolute inset-0 z-30 hidden md:block"></div>
      <div
        data-runner
        class="pointer-events-none absolute left-0 top-0 z-30 hidden w-16 -translate-x-1/2 -translate-y-1/2 md:block"
      >
        <img data-runner-bounce src="/images/running-dog.png" alt="" class="w-full drop-shadow-md" />
      </div>

      <div data-reveal class="group relative w-full md:w-1/2">
        <div class="blob-shape absolute inset-0 rotate-3 scale-105 border-4 border-primary bg-secondary-container"></div>
        <div class="sticker relative z-10 -rotate-2 flex flex-col items-center rounded-3xl border-4 border-primary bg-surface-container-lowest p-8 text-center md:p-12">
          <div class="hard-shadow mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-primary">
            <span class="material-symbols-outlined text-5xl text-secondary-container">chat</span>
          </div>
          <h2 class="font-display mb-4 text-4xl uppercase text-primary md:text-5xl">¡Hablemos de tu perrito!</h2>
          <p class="mb-8 text-on-surface-variant">¿Tienes dudas sobre el comportamiento de tu mejor amigo? Escríbenos y te asesoramos.</p>
          <a
            data-whatsapp-button
            href="https://wa.me/573027603654"
            target="_blank"
            rel="noopener noreferrer"
            class="hard-shadow hard-shadow-hover flex items-center gap-3 rounded-full border-[3px] border-secondary-container bg-primary px-10 py-4 text-lg font-bold uppercase tracking-widest text-secondary-container transition-all duration-200"
          >
            WhatsApp
            <span class="material-symbols-outlined">send</span>
          </a>
        </div>
      </div>

      <div class="flex w-full flex-col items-center md:w-1/2 md:items-start">
        <div class="relative w-full max-w-md">
          <div data-float data-spin class="blob-shape-2 pointer-events-none absolute -right-8 -top-8 h-32 w-32 bg-tertiary-fixed-dim opacity-60"></div>
          <div class="relative z-10 grid grid-cols-2 gap-4">
            <div data-reveal class="sticker aspect-square rotate-3 overflow-hidden rounded-2xl border-4 border-primary">
              <img src="/images/instagram-1.jpg" alt="La manada de Desarrollo Canino" class="h-full w-full object-cover" />
            </div>
            <div data-reveal class="sticker mt-8 aspect-square -rotate-6 overflow-hidden rounded-2xl border-4 border-primary">
              <img src="/images/instagram-2.jpg" alt="Alumnos de Desarrollo Canino" class="h-full w-full object-cover" />
            </div>
          </div>
          <div class="mt-12 text-center md:text-left">
            <h2 data-reveal class="font-display mb-4 rotate-1 text-4xl uppercase text-primary md:text-5xl">Únete a nuestra manada</h2>
            <p data-reveal class="mb-6 text-on-surface-variant">Mira el progreso de nuestros alumnos y tips diarios en Instagram.</p>
            <a
              data-reveal
              href="https://instagram.com/desarrollo_canino"
              target="_blank"
              rel="noopener noreferrer"
              class="sticker inline-flex items-center gap-2 rounded-xl border-4 border-primary bg-secondary-fixed-dim px-6 py-3 text-label-caps font-bold uppercase text-primary transition-transform hover:scale-105"
            >
              @desarrollo_canino
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
