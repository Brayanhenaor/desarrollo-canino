---

<footer data-reveal-group class="relative mt-sp-xl w-full overflow-hidden rounded-t-[3rem] border-t-8 border-secondary-container bg-primary shadow-lg">
  <div class="pointer-events-none absolute -left-20 -top-20 h-64 w-64 rounded-full bg-primary-container opacity-50 blur-3xl"></div>
  <div class="relative z-10 mx-auto flex max-w-[1280px] flex-col px-margin-desktop py-sp-lg">
    <div class="flex flex-col items-center justify-between gap-12 md:flex-row md:items-start">
      <div data-reveal class="flex flex-col items-center md:items-start">
        <a href="#inicio" class="mb-4 flex items-center gap-2 text-headline-lg font-bold text-on-primary">
          <span class="material-symbols-outlined text-4xl text-secondary-container" style="font-variation-settings: 'FILL' 1;">pets</span>
          Desarrollo Canino
        </a>
        <p class="mb-4 max-w-sm text-center text-on-primary/80 md:text-left">
          Adiestramiento basado en el bienestar emocional y cognitivo. Ubicados en Robledo Pajarito, Calle 72 #99-183, Medellín.
        </p>
      </div>

      <div data-reveal class="flex flex-col gap-12 text-center md:flex-row md:text-left">
        <div class="flex flex-col gap-4">
          <h4 class="font-display mb-2 text-2xl font-bold text-secondary-container">Contacto</h4>
          <a href="tel:+573046087510" class="flex items-center justify-center gap-2 text-on-primary/90 transition-all hover:text-secondary-container md:justify-start">
            <span class="material-symbols-outlined text-xl">phone_iphone</span> +57 304 608 7510
          </a>
          <a href="https://instagram.com/desarrollo_canino" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 text-on-primary/90 transition-all hover:text-secondary-container md:justify-start">
            <span class="font-bold">@desarrollo_canino</span>
          </a>
        </div>
        <div class="flex flex-col gap-4">
          <h4 class="font-display mb-2 text-2xl font-bold text-secondary-container">Enlaces</h4>
          <a href="#servicios" class="text-on-primary/90 transition-all hover:text-secondary-container">Servicios</a>
          <a href="#metodologia" class="text-on-primary/90 transition-all hover:text-secondary-container">Metodología</a>
        </div>
      </div>
    </div>

    <div data-reveal class="mt-12 flex flex-col items-center gap-4 border-t border-on-primary/15 pt-8 text-center">
      <a
        href="https://bhenao.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 text-base uppercase tracking-wide text-on-primary/80 transition-all hover:text-secondary-container"
      >
        Sitio web Desarrollado por
        <img src="/brand/bhenao-logo.svg" alt="bhenao.com" class="h-8 w-auto" />
      </a>
    </div>
  </div>
</footer>
