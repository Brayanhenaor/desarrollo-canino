---
const images = Array.from({ length: 9 }, (_, i) => `/images/gallery/gallery-${i + 1}.webp`);
---

<div id="gallery-modal" data-gallery class="fixed inset-0 z-[100] hidden items-center justify-center bg-inverse-surface/90 p-4 backdrop-blur-sm">
  <button
    data-gallery-close
    type="button"
    aria-label="Cerrar galería"
    class="hard-shadow absolute right-4 top-4 z-10 flex h-12 w-12 items-center justify-center rounded-full border-2 border-primary bg-secondary-container text-primary"
  >
    <span class="material-symbols-outlined text-2xl">close</span>
  </button>

  <button
    data-gallery-prev
    type="button"
    aria-label="Foto anterior"
    class="hard-shadow absolute left-2 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-2 border-primary bg-secondary-container text-primary md:left-6"
  >
    <span class="material-symbols-outlined text-2xl">chevron_left</span>
  </button>
  <button
    data-gallery-next
    type="button"
    aria-label="Foto siguiente"
    class="hard-shadow absolute right-2 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-2 border-primary bg-secondary-container text-primary md:right-6"
  >
    <span class="material-symbols-outlined text-2xl">chevron_right</span>
  </button>

  <div class="flex max-h-full w-full max-w-3xl flex-col items-center gap-4">
    <div class="sticker w-full overflow-hidden rounded-3xl border-4 border-primary bg-surface-container-lowest">
      <img data-gallery-active-image src={images[0]} alt="Instalaciones de Desarrollo Canino" class="max-h-[65vh] w-full object-contain" />
    </div>
    <p data-gallery-counter class="text-label-caps font-bold uppercase text-inverse-on-surface">1 / {images.length}</p>
    <div class="flex max-w-full gap-2 overflow-x-auto px-2 pb-2">
      {
        images.map((src, i) => (
          <button
            type="button"
            data-gallery-thumb
            data-active={i === 0 ? "true" : "false"}
            aria-label={`Ver foto ${i + 1}`}
            class="h-14 w-14 shrink-0 overflow-hidden rounded-lg border-2 border-primary opacity-60 transition-opacity data-[active=true]:opacity-100"
          >
            <img src={src} alt="" class="h-full w-full object-cover" />
          </button>
        ))
      }
    </div>
  </div>
</div>
