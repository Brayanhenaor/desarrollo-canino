---
---

<section id="inicio" data-hero class="relative flex min-h-[90vh] items-center justify-center overflow-hidden px-4 pt-12 md:pt-0">
  <div data-parallax="0.2" class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center">
    <div data-hero-blob data-spin class="blob-shape h-[120vw] w-[120vw] bg-secondary-container opacity-90 md:h-[80vw] md:w-[80vw]"></div>
  </div>
  <div data-parallax="0.4" class="pointer-events-none absolute inset-0 z-0 ml-20 mt-20 flex items-center justify-center">
    <div data-hero-blob class="blob-shape-2 h-[100vw] w-[100vw] bg-tertiary-fixed-dim opacity-60 md:h-[70vw] md:w-[70vw]"></div>
  </div>

  <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-col items-center justify-between md:flex-row">
    <div class="z-20 flex w-full flex-col items-start justify-center pt-10 md:w-1/2 md:pt-0">
      <div data-hero-badge class="sticker mb-6 -rotate-2 inline-flex items-center gap-2 rounded-full border-2 border-primary bg-surface-container-lowest px-4 py-2">
        <span class="material-symbols-outlined text-secondary-container" style="font-variation-settings: 'FILL' 1;">location_on</span>
        <span class="text-label-caps font-bold uppercase text-primary">Ubicados en el corazón de Robledo Pajarito, Medellín</span>
      </div>

      <h1 data-hero-title class="font-display mb-6 -rotate-3 text-[40px] font-extrabold uppercase leading-[0.9] text-primary mix-blend-multiply sm:text-[64px] md:text-[84px]">
        Adiestramiento<br />que Fluye<br />con su Energía
      </h1>

      <p data-hero-text class="sticker mb-8 max-w-md rotate-1 rounded-2xl border-2 border-primary bg-surface-container-lowest/90 p-5 text-body-md text-on-surface-variant">
        Enfoque Cognitivo-Emocional: Creamos una relación de entendimiento mutuo para que tu perro tome decisiones correctas de forma autónoma.
      </p>

      <div data-hero-cta class="flex w-full flex-col items-center gap-4 sm:w-auto sm:flex-row">
        <button
          type="button"
          class="hard-shadow hard-shadow-hover group flex w-full items-center justify-center gap-2 rounded-full border-[3px] border-secondary-container bg-primary px-8 py-4 text-lg font-bold uppercase tracking-widest text-secondary-container transition-all duration-200 sm:w-auto"
        >
          Empieza Hoy
          <span class="material-symbols-outlined transition-transform group-hover:translate-x-1">arrow_forward</span>
        </button>
      </div>
    </div>

    <div class="relative z-10 mt-16 flex w-full items-center justify-center md:mt-0 md:w-1/2">
      <div data-hero-image class="relative h-[450px] w-[320px] md:h-[650px] md:w-[500px]">
        <div class="blob-shape absolute inset-0 rotate-6 scale-105 border-8 border-surface-container-lowest bg-primary shadow-[0_0_0_4px_#163428]"></div>
        <img
          src="/images/hero-dogs.jpg"
          alt="Perros de la manada en las instalaciones de Desarrollo Canino"
          class="blob-shape absolute inset-0 z-10 h-full w-full object-cover"
        />
        <div data-hero-sticker class="sticker absolute -top-12 -right-8 z-20 flex h-24 w-24 rotate-12 items-center justify-center overflow-hidden rounded-full border-4 border-primary bg-surface-container-lowest p-3">
          <img src="/images/hero-badge-dog.jpg" alt="Alumno de Desarrollo Canino" class="h-full w-full object-cover" />
        </div>
        <div data-hero-sticker class="sticker absolute bottom-12 -left-12 z-20 -rotate-6 rounded-2xl border-4 border-primary bg-secondary-container p-6">
          <p class="font-display text-headline-lg-mobile font-bold leading-none text-primary">100%</p>
          <p class="mt-1 text-label-caps uppercase text-on-primary-fixed">Refuerzo Positivo</p>
        </div>
      </div>
    </div>
  </div>
</section>
