---
const links = [
  { href: "#inicio", label: "Inicio" },
  { href: "#servicios", label: "Servicios" },
  { href: "#precios", label: "Precios" },
  { href: "#metodologia", label: "Metodología" },
];
const whatsapp = "https://wa.me/573046087510";
---

<nav data-nav class="sticky top-0 z-50 w-full px-4 pt-sp-md md:px-margin-desktop">
  <div
    data-nav-inner
    class="mx-auto flex max-w-[1280px] items-center justify-between rounded-full px-organic-margin py-4 transition-all duration-300 md:px-section-gap"
  >
    <a href="#inicio" class="flex items-center gap-2 text-2xl font-bold text-on-surface">
      <span class="material-symbols-outlined text-tertiary-container" style="font-variation-settings: 'FILL' 1;">pets</span>
      Desarrollo Canino
    </a>

    <div class="sticker hidden items-center gap-8 rounded-full border-2 border-primary bg-primary-container px-8 py-3 md:flex">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            class={`font-body text-label-caps uppercase transition-all hover:text-secondary-container ${i === 0 ? "font-bold text-secondary-fixed-dim" : "text-on-primary-container/80"}`}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href={whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="hard-shadow hard-shadow-hover hidden rounded-full border-[3px] border-primary bg-secondary-container px-6 py-3 text-label-caps font-bold uppercase tracking-widest text-primary transition-all duration-200 md:block"
    >
      Contáctanos
    </a>

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
      class="text-primary md:hidden"
    >
      <span class="material-symbols-outlined text-3xl" data-menu-icon>menu</span>
    </button>
  </div>

  <div id="mobile-menu" data-mobile-menu class="mx-4 mt-3 hidden md:hidden">
    <div class="sticker flex flex-col gap-1 rounded-3xl border-4 border-primary bg-surface-container-lowest p-4">
      {
        links.map((link) => (
          <a href={link.href} class="rounded-xl px-4 py-3 font-bold uppercase text-primary transition-colors hover:bg-primary-fixed">
            {link.label}
          </a>
        ))
      }
      <a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="hard-shadow mt-2 flex items-center justify-center gap-2 rounded-full border-[3px] border-secondary-container bg-primary px-6 py-3 text-label-caps font-bold uppercase tracking-widest text-secondary-container"
      >
        Contáctanos
        <span class="material-symbols-outlined text-lg">send</span>
      </a>
    </div>
  </div>
</nav>
